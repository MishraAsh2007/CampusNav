{
  "$defs": {
    "Closure": {
      "properties": {
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lng": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lng",
          "type": "number"
        },
        "radius": {
          "description": "Affected radius in meters",
          "exclusiveMinimum": 0,
          "maximum": 1000,
          "title": "Radius",
          "type": "number"
        },
        "type": {
          "enum": [
            "elevator",
            "ramp",
            "path"
          ],
          "title": "Type",
          "type": "string"
        },
        "status": {
          "enum": [
            "closed",
            "degraded"
          ],
          "title": "Status",
          "type": "string"
        },
        "source": {
          "enum": [
            "official",
            "community",
            "verified"
          ],
          "title": "Source",
          "type": "string"
        },
        "start_time": {
          "format": "date-time",
          "title": "Start Time",
          "type": "string"
        },
        "end_time": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "End Time"
        },
        "last_confirmed": {
          "format": "date-time",
          "title": "Last Confirmed",
          "type": "string"
        },
        "asset_id": {
          "anyOf": [
            {
              "maxLength": 150,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Id"
        },
        "building_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Building Id"
        },
        "floor_id": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Floor Id"
        }
      },
      "required": [
        "lat",
        "lng",
        "radius",
        "type",
        "status",
        "source",
        "start_time",
        "end_time",
        "last_confirmed"
      ],
      "title": "Closure",
      "type": "object"
    },
    "DrawingEndpoint": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "drawing",
          "title": "Kind",
          "type": "string"
        },
        "building_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$",
          "title": "Building Id",
          "type": "string"
        },
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "portal_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Portal Id"
        }
      },
      "required": [
        "kind",
        "building_id",
        "node_id"
      ],
      "title": "DrawingEndpoint",
      "type": "object"
    },
    "IndoorEndpoint": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "indoor",
          "title": "Kind",
          "type": "string"
        },
        "building_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$",
          "title": "Building Id",
          "type": "string"
        },
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "portal_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Portal Id"
        }
      },
      "required": [
        "kind",
        "building_id",
        "node_id"
      ],
      "title": "IndoorEndpoint",
      "type": "object"
    },
    "OutdoorEndpoint": {
      "additionalProperties": false,
      "properties": {
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lng": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lng",
          "type": "number"
        },
        "kind": {
          "const": "outdoor",
          "title": "Kind",
          "type": "string"
        },
        "graph_node_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Graph Node Id"
        }
      },
      "required": [
        "lat",
        "lng",
        "kind"
      ],
      "title": "OutdoorEndpoint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "max_grade": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": 5,
      "title": "Max Grade"
    },
    "no_stairs": {
      "default": true,
      "title": "No Stairs",
      "type": "boolean"
    },
    "allow_unknown_access": {
      "default": false,
      "title": "Allow Unknown Access",
      "type": "boolean"
    },
    "allow_unknown_grade": {
      "default": false,
      "title": "Allow Unknown Grade",
      "type": "boolean"
    },
    "need_automatic_door": {
      "default": false,
      "title": "Need Automatic Door",
      "type": "boolean"
    },
    "min_width_m": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "maximum": 5,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Min Width M"
    },
    "origin": {
      "discriminator": {
        "mapping": {
          "drawing": "#/$defs/DrawingEndpoint",
          "indoor": "#/$defs/IndoorEndpoint",
          "outdoor": "#/$defs/OutdoorEndpoint"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/OutdoorEndpoint"
        },
        {
          "$ref": "#/$defs/IndoorEndpoint"
        },
        {
          "$ref": "#/$defs/DrawingEndpoint"
        }
      ],
      "title": "Origin"
    },
    "destination": {
      "discriminator": {
        "mapping": {
          "drawing": "#/$defs/DrawingEndpoint",
          "indoor": "#/$defs/IndoorEndpoint",
          "outdoor": "#/$defs/OutdoorEndpoint"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/OutdoorEndpoint"
        },
        {
          "$ref": "#/$defs/IndoorEndpoint"
        },
        {
          "$ref": "#/$defs/DrawingEndpoint"
        }
      ],
      "title": "Destination"
    },
    "closures": {
      "items": {
        "$ref": "#/$defs/Closure"
      },
      "maxItems": 500,
      "title": "Closures",
      "type": "array"
    },
    "accept_drawing_only": {
      "default": false,
      "title": "Accept Drawing Only",
      "type": "boolean"
    },
    "resident_access_confirmed": {
      "default": false,
      "title": "Resident Access Confirmed",
      "type": "boolean"
    }
  },
  "required": [
    "origin",
    "destination"
  ],
  "title": "JourneyRequest",
  "type": "object"
}
