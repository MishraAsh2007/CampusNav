{
  "$defs": {
    "Coordinate": {
      "additionalProperties": false,
      "properties": {
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lng": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lng",
          "type": "number"
        }
      },
      "required": [
        "lat",
        "lng"
      ],
      "title": "Coordinate",
      "type": "object"
    },
    "LocationQuery": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "default": "",
          "maxLength": 500,
          "title": "Text",
          "type": "string"
        },
        "building_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Building Id"
        },
        "floor_id": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Floor Id"
        },
        "node_id": {
          "anyOf": [
            {
              "maxLength": 150,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Node Id"
        },
        "outdoor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Coordinate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "LocationQuery",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "location": {
      "$ref": "#/$defs/LocationQuery"
    },
    "purpose": {
      "default": "origin",
      "enum": [
        "origin",
        "destination"
      ],
      "title": "Purpose",
      "type": "string"
    }
  },
  "required": [
    "location"
  ],
  "title": "ResolveRequest",
  "type": "object"
}
