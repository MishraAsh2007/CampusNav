{
  "$defs": {
    "Coordinate": {
      "additionalProperties": false,
      "properties": {
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lng": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lng",
          "type": "number"
        }
      },
      "required": [
        "lat",
        "lng"
      ],
      "title": "Coordinate",
      "type": "object"
    },
    "Floor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "coordinate_system": {
          "default": "local_meters",
          "enum": [
            "local_meters",
            "image_pixels"
          ],
          "title": "Coordinate System",
          "type": "string"
        },
        "image_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Url"
        },
        "image_width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Width"
        },
        "image_height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Height"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "aliases": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Aliases",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "source_id"
      ],
      "title": "Floor",
      "type": "object"
    },
    "IndoorAsset": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 150,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "kind": {
          "enum": [
            "elevator",
            "ramp",
            "path"
          ],
          "title": "Kind",
          "type": "string"
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/Coordinate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "aliases": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Aliases",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "kind",
        "source_id"
      ],
      "title": "IndoorAsset",
      "type": "object"
    },
    "IndoorEdge": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 150,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "start": {
          "title": "Start",
          "type": "string"
        },
        "end": {
          "title": "End",
          "type": "string"
        },
        "kind": {
          "enum": [
            "corridor",
            "door",
            "ramp",
            "steps",
            "elevator"
          ],
          "title": "Kind",
          "type": "string"
        },
        "length_m": {
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Length M",
          "type": "number"
        },
        "geometry": {
          "anyOf": [
            {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Geometry"
        },
        "asset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Id"
        },
        "bidirectional": {
          "default": true,
          "title": "Bidirectional",
          "type": "boolean"
        },
        "public_access": {
          "title": "Public Access",
          "type": "boolean"
        },
        "step_free": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Step Free"
        },
        "grade_percent": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grade Percent"
        },
        "width_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width M"
        },
        "door_type": {
          "default": "unknown",
          "enum": [
            "automatic",
            "push-button",
            "manual",
            "unknown"
          ],
          "title": "Door Type",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "evidence": {
          "minLength": 10,
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "id",
        "start",
        "end",
        "kind",
        "length_m",
        "public_access",
        "step_free",
        "source_id",
        "evidence"
      ],
      "title": "IndoorEdge",
      "type": "object"
    },
    "IndoorNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 150,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "floor_id": {
          "title": "Floor Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "room",
            "entrance",
            "junction",
            "elevator_stop",
            "stair_landing"
          ],
          "title": "Kind",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/Coordinate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "aliases": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Aliases",
          "type": "array"
        },
        "source_record_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Source Record Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "floor_id",
        "kind",
        "x",
        "y",
        "source_id"
      ],
      "title": "IndoorNode",
      "type": "object"
    },
    "IndoorSource": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 150,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "edition": {
          "title": "Edition",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "url",
        "edition",
        "observed_at"
      ],
      "title": "IndoorSource",
      "type": "object"
    },
    "Maneuver": {
      "additionalProperties": false,
      "description": "Reviewed, direction-specific guidance: never inferred from a room number.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "from_node": {
          "title": "From Node",
          "type": "string"
        },
        "via_node": {
          "title": "Via Node",
          "type": "string"
        },
        "to_node": {
          "title": "To Node",
          "type": "string"
        },
        "instruction": {
          "maxLength": 500,
          "minLength": 5,
          "title": "Instruction",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "evidence": {
          "minLength": 10,
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "id",
        "from_node",
        "via_node",
        "to_node",
        "instruction",
        "source_id",
        "evidence"
      ],
      "title": "Maneuver",
      "type": "object"
    },
    "Portal": {
      "additionalProperties": false,
      "description": "A reviewed path from an indoor entrance to an EXISTING outdoor graph node.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "indoor_node_id": {
          "title": "Indoor Node Id",
          "type": "string"
        },
        "outdoor_node_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "title": "Outdoor Node Id"
        },
        "geometry": {
          "description": "WGS84 [lng, lat]",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "minItems": 2,
          "title": "Geometry",
          "type": "array"
        },
        "length_m": {
          "exclusiveMinimum": 0,
          "title": "Length M",
          "type": "number"
        },
        "public_access": {
          "title": "Public Access",
          "type": "boolean"
        },
        "step_free": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Step Free"
        },
        "grade_percent": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grade Percent"
        },
        "width_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width M"
        },
        "door_type": {
          "default": "unknown",
          "enum": [
            "automatic",
            "push-button",
            "manual",
            "unknown"
          ],
          "title": "Door Type",
          "type": "string"
        },
        "asset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Id"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "evidence": {
          "minLength": 10,
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "id",
        "indoor_node_id",
        "outdoor_node_id",
        "geometry",
        "length_m",
        "public_access",
        "step_free",
        "source_id",
        "evidence"
      ],
      "title": "Portal",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1,
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "building_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$",
      "title": "Building Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "synthetic": {
      "default": false,
      "title": "Synthetic",
      "type": "boolean"
    },
    "status": {
      "default": "draft",
      "enum": [
        "draft",
        "reviewed"
      ],
      "title": "Status",
      "type": "string"
    },
    "reviewed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewed At"
    },
    "review_notes": {
      "default": "",
      "title": "Review Notes",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/IndoorSource"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "floors": {
      "items": {
        "$ref": "#/$defs/Floor"
      },
      "minItems": 1,
      "title": "Floors",
      "type": "array"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/IndoorNode"
      },
      "maxItems": 20000,
      "title": "Nodes",
      "type": "array"
    },
    "assets": {
      "items": {
        "$ref": "#/$defs/IndoorAsset"
      },
      "maxItems": 1000,
      "title": "Assets",
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/IndoorEdge"
      },
      "maxItems": 50000,
      "title": "Edges",
      "type": "array"
    },
    "portals": {
      "items": {
        "$ref": "#/$defs/Portal"
      },
      "maxItems": 30,
      "title": "Portals",
      "type": "array"
    },
    "maneuvers": {
      "items": {
        "$ref": "#/$defs/Maneuver"
      },
      "maxItems": 5000,
      "title": "Maneuvers",
      "type": "array"
    }
  },
  "required": [
    "building_id",
    "name",
    "sources",
    "floors"
  ],
  "title": "IndoorMap",
  "type": "object"
}
