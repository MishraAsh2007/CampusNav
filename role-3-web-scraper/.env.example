# Copy to .env (never commit .env)
GEMINI_API_KEY=
# gemini-1.5-flash is shut down; 3.8 Flash is GA as of Nov 2026
GEMINI_MODEL=gemini-3.8-flash
# Facilities alert page to scrape (optional)
FACILITIES_URL=
# Only needed with --post-to-backend
CAMPUSNAV_API_URL=http://127.0.0.1:8000
# Same value as CAMPUSNAV_ADMIN_KEY in backend/.env; needed to update official notices
CAMPUSNAV_ADMIN_KEY=
