{
  "name": "campusnav",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "CampusNav: Real-Time Step-Free Campus Navigator with Outage Adaptation & Gemini Route Narration",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test:integration": "node --test --test-concurrency=1 tests/live-api.test.mjs tests/indoor-directions.test.mjs tests/map-camera.test.mjs",
    "dev:phone": "vite --mode https"
  },
  "dependencies": {
    "@vis.gl/react-google-maps": "^1.10.2",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.460.0",
    "pannellum": "^2.5.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/google.maps": "^3.58.0",
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
