# CampusNav integration. Copy to .env only if changing defaults.
# Backend: same origin in production; Vite proxies API paths to http://127.0.0.1:8000.
# Map tiles still require internet. Routing and saved notices are served locally.

# Google Maps basemap (Maps JavaScript API; Places API (New) adds Google's wheelchair info to building sheets).
# Restrict the key to HTTP referrers like http://localhost:5173/* in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=
# Advanced markers need a Map ID. DEMO_MAP_ID is used if empty.
VITE_GOOGLE_MAPS_MAP_ID=

# Set only when hosting the Python API separately; configure its allowed CORS origins too.
VITE_API_BASE_URL=
# Optional separate origin for the Python router and its indoor catalog.
VITE_ROUTING_API_URL=
VITE_INDOOR_API_URL=
# "auto" uses the Python router when available. "local" uses the browser router.
VITE_ROUTING_ENGINE=auto
VITE_INDOOR_SAMPLES=fallback
# Gemini parsing uses GEMINI_API_KEY in the backend's private .env.
# Never put a Gemini API key in a VITE_* variable; Vite embeds those into public JavaScript.

VITE_MAP_DEFAULT_LAT=42.3903
VITE_MAP_DEFAULT_LNG=-72.5275
