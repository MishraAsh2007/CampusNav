# Set these in your shell or hosting service; the app does not load .env automatically.
ROUTING_GRAPH=data/umass.graph.json
# Reviewed indoor JSON maps, separate from floor-reference scraping and synthetic fixtures.
INDOOR_MAPS_DIR=data/indoor
ROUTING_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Role 3's CLI loads this project's .env. Gemini is optional; rules always run first.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OFFICIAL_CLOSURES_SNAPSHOT=data/official_snapshot.json
EXTERNAL_REPORTS_SNAPSHOT=data/private/external_reports.json
# Public reports use authorized read-only app tokens; never put them in source configs.
REDDIT_ACCESS_TOKEN=
REDDIT_USER_AGENT=
FACEBOOK_PAGE_ACCESS_TOKEN=
