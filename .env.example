# CampusNav environment. Copy to .env. Everything is optional: with no keys the app runs fully offline.

# Google Maps basemap (Maps JavaScript API; Places API (New) adds Google's wheelchair info to building sheets).
# Restrict the key to HTTP referrers like http://localhost:5173/* in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=
# Advanced markers need a Map ID. DEMO_MAP_ID is used if empty.
VITE_GOOGLE_MAPS_MAP_ID=

# Gemini route summaries. Falls back to an instant template if missing or slower than 2.5 s.
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-3.8-flash

# Role 4 backend (closures, buildings, reports) and Role 1 routing engine
VITE_API_BASE_URL=http://localhost:8000
# Role 1 routing engine (routing/ on the Ash_ver branch: `uvicorn app.main:app --port 8001`).
# The frontend probes its GET /health and sends POST /api/route. Empty = same as VITE_API_BASE_URL.
VITE_ROUTING_API_URL=http://localhost:8001
# auto = use Role 1 when reachable and its answer is valid, else the in-browser router
# local = always in-browser (safest for a live demo), remote = always try Role 1 first
VITE_ROUTING_ENGINE=auto

VITE_MAP_DEFAULT_LAT=42.3903
VITE_MAP_DEFAULT_LNG=-72.5275
# Indoor floor detection: GPS altitude (m) of a building's ground floor. Default 65. Browsers report
# height above the WGS84 ellipsoid, so the app also calibrates this at the entrance on first use.
VITE_GROUND_ALTITUDE_M=
# Indoor maps. Map files in data/indoor/*.json (IndoorMap v1) are picked up automatically.
# Optional live source: the campus_routing server (GET /indoor/status, GET /indoor/maps/{id}).
VITE_INDOOR_API_URL=
# Built-in sample layouts (ILC, Campus Center, Student Union, Du Bois):
# fallback = only where no real map exists (default), prefer = always use them, off = hide them
VITE_INDOOR_SAMPLES=fallback
